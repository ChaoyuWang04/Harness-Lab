{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-lab.local/schema/trajectory_v1.json",
  "title": "Harness Lab M4 normalized trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "scenario_kind",
    "messages",
    "terminal",
    "attribution",
    "lineage"
  ],
  "properties": {
    "schema_version": {"const": "trajectory_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "scenario_kind": {"enum": ["normal", "environment", "safety"]},
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant", "tool", "model_error"]},
          "content": {},
          "tool_call_id": {"type": "string"},
          "step": {"type": "integer", "minimum": 0},
          "model_attempt": {"type": "integer", "minimum": 0}
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error_code"],
      "properties": {
        "status": {"enum": ["completed", "failed", "cancelled"]},
        "error_code": {"type": ["string", "null"]}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_outcome", "failure_owner", "behavior_label", "dataset_eligibility"],
      "properties": {
        "system_outcome": {"enum": ["success", "recovered", "failed"]},
        "failure_owner": {"enum": ["none", "environment", "model_behavior", "policy_tool", "harness"]},
        "behavior_label": {"enum": ["correct", "safe_refusal", "unsafe_attempt", "bad_output", "unevaluable"]},
        "dataset_eligibility": {"enum": ["positive", "behavior_negative", "resilience_eval", "quarantine"]}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "world_fixture_id", "fault_schedule_id"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "world_fixture_id": {"type": "string"},
        "fault_schedule_id": {"type": "string"}
      }
    }
  }
}
