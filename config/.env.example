# Copy this file to ../secrets/.env and replace values locally.
# Later Compose files must use: env_file: ./secrets/.env

SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com
# US: https://us.cloud.langfuse.com
# Japan: https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Default inside Compose. Override with any OpenAI-compatible endpoint, including Modal.
LLM_BASE_URL=http://ollama:11434/v1
HARNESS_COMPOSE_LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:0.6b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5

DATABASE_URL=postgresql+psycopg://postgres:harness@postgres:5432/harness
TEST_DATABASE_URL=postgresql+psycopg://postgres:harness@127.0.0.1:5432/harness
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/0
LEASE_SECONDS=30
MAX_ATTEMPTS=3
HARNESS_TEST_PAUSE_AFTER_TOOL_SECONDS=0
HARNESS_OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
OTEL_METRIC_EXPORT_INTERVAL_MS=5000
OTEL_EXPORT_TIMEOUT_MS=3000

# M3 chaos defaults are inert. Enable them only through the registered M3 runner.
CHAOS_SEED=0
CHAOS_429_RATE=0
CHAOS_TIMEOUT_RATE=0
CHAOS_5XX_RATE=0
CHAOS_LATENCY_MS=0
CHAOS_TIMEOUT_SECONDS=31
