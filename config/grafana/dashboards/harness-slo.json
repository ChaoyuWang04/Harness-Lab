{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Run P95 duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 60}]}}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_run_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "P95"}]
    },
    {
      "id": 2,
      "title": "Run failed rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.01}]}}},
      "targets": [{"refId": "A", "expr": "sum(rate(agent_run_failed_total[$__rate_interval])) / clamp_min(sum(rate(agent_run_total[$__rate_interval])), 0.000001)", "legendFormat": "failed rate"}]
    },
    {
      "id": 3,
      "title": "Queue lag P95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 10}]}}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_queue_lag_seconds_bucket[$__rate_interval])))", "legendFormat": "P95"}]
    },
    {
      "id": 4,
      "title": "Model errors and tool latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {}},
      "targets": [
        {"refId": "A", "expr": "sum by (http_status) (rate(agent_model_call_total{http_status=~\"429|timeout\"}[$__rate_interval]))", "legendFormat": "model {{http_status}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(agent_tool_latency_ms_bucket[$__rate_interval])))", "legendFormat": "tool {{tool_name}} P95 ms"}
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 40,
  "tags": ["harness-lab", "m2"],
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "Harness SLO",
  "uid": "harness-slo",
  "version": 1
}
