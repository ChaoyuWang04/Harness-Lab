{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Run P95 duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 60}]}}},
      "description": "Execution duration P95 across RQ workhorses retained since the current telemetry stack started.",
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (agent_run_duration_seconds_bucket))", "legendFormat": "P95"}]
    },
    {
      "id": 2,
      "title": "Run failed rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.01}]}}},
      "description": "Terminal failure fraction since the current telemetry stack started. Zero failures are rendered as 0%, not No data.",
      "targets": [{"refId": "A", "expr": "(sum(agent_run_failed_total) or vector(0)) / clamp_min(sum(agent_run_total), 1)", "legendFormat": "failed rate"}]
    },
    {
      "id": 3,
      "title": "Queue lag P95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 10}]}}},
      "description": "Created-to-claim queue delay P95 across RQ workhorses retained since the current telemetry stack started.",
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (agent_queue_lag_seconds_bucket))", "legendFormat": "P95"}]
    },
    {
      "id": 4,
      "title": "Model errors and tool latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "A"},
            "properties": [
              {"id": "unit", "value": "short"},
              {"id": "custom.axisPlacement", "value": "left"}
            ]
          },
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "unit", "value": "ms"},
              {"id": "custom.axisPlacement", "value": "right"}
            ]
          }
        ]
      },
      "targets": [
        {"refId": "A", "expr": "sum by (http_status) (agent_model_call_total{http_status=~\"429|timeout|error\"})", "legendFormat": "model {{http_status}} total"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, tool_name) (agent_tool_latency_ms_bucket))", "legendFormat": "tool {{tool_name}} P95 ms"}
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 40,
  "tags": ["harness-lab", "m2"],
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "Harness SLO",
  "uid": "harness-slo",
  "version": 1
}
